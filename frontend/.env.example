NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-ET4QEE12B5
PEXELS_API_KEY=
# Must match the backend's INTERNAL_API_KEY — required for server-side calls
# to internal-key-gated routes (e.g. GET /api/vehicles/dealer/:slug).
INTERNAL_API_KEY=
# Optional. On a VPS, set this to the loopback API (e.g. http://127.0.0.1:4100)
# so Next.js server components do not hairpin through public nginx.
API_INTERNAL_URL=
