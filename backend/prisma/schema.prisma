generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dealer {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  /** Street address. Nullable — Auto.dev-discovered dealers have no street-level address, only city/state/zip; never fabricate one. */
  address                String?
  city                   String
  state                  String
  zip                    String
  phone                  String?
  email                  String?
  website                String?
  description            String?
  logo                   String?
  featured               Boolean  @default(false)
  googleRating           Float?
  googleReviewCount      Int?
  yelpRating             Float?
  yelpReviewCount        Int?
  carfaxRating           Float?
  carfaxUrl              String?
  /** Last time the Carfax scraper successfully read this dealer's page (blocked / not-found attempts don't count). Drives the refresh-interval skip in carfax-lookup.service.ts. */
  carfaxCheckedAt        DateTime?
  autoSalesReviewsRating Float?
  platformRating         Float?
  platformReviewCount    Int      @default(0)
  combinedRating         Float?
  manualRatingOverride   Float?
  useManualRating        Boolean  @default(false)
  hasBadge               Boolean  @default(false)
  badgeYear              Int?
  autoDevDealerId        String?
  googlePlaceId          String?
  yelpBusinessId         String?
  /** When true, the daily Yelp sync skips this dealer permanently instead of re-matching it on the next run. */
  yelpExcluded           Boolean  @default(false)
  /** Last time the Yelp sync got a definitive answer for this dealer, matched, not-found, or low-confidence (quota cutoffs and transient errors don't count). Drives the refresh-interval skip in yelp-lookup.service.ts so a permanent no-match isn't retried every single day. */
  yelpCheckedAt          DateTime?
  /** "manual" (admin-entered / legacy seed) or "autodev" (discovered from live Auto.dev listings). */
  source                 String   @default("manual")
  /**
   * Per-dealer rating source overrides. Null means "inherit the global
   * RatingSourceSettings toggle"; true/false pins this dealer's source on or
   * off regardless of the global setting — e.g. hiding Google/Yelp for one
   * dealer while every other dealer keeps showing them.
   */
  googleEnabledOverride           Boolean?
  yelpEnabledOverride             Boolean?
  carfaxEnabledOverride           Boolean?
  autoSalesReviewsEnabledOverride Boolean?
  platformEnabledOverride         Boolean?
  /**
   * Dealer self-service portal login. Separate from `email` (public contact
   * address shown to customers) — loginEmail/passwordHash are only ever set
   * by an admin issuing portal access, never self-registered. Null means the
   * dealer has no portal access yet.
   */
  loginEmail             String?  @unique
  passwordHash           String?
  createdAt              DateTime @default(now())
  reviews                Review[]
  vehicles               Vehicle[]
  sessions               DealerSession[]
  updates                DealerUpdate[]

  @@index([state])
  @@index([city])
  @@index([featured])
  @@index([combinedRating])
  @@index([source])
}

/** Opaque bearer session for the dealer self-service portal — same pattern as
 * AdminAccount but per-dealer and revocable/expiring, since there are many
 * dealer accounts instead of one shared admin secret. */
model DealerSession {
  id        String   @id @default(cuid())
  token     String   @unique
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([dealerId])
  @@index([expiresAt])
}

/** A dealer-authored update/announcement, posted from the self-service
 * portal and shown publicly on that dealer's profile page. */
model DealerUpdate {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([dealerId])
  @@index([createdAt])
}

model Vehicle {
  id               String   @id @default(cuid())
  dealerId         String
  dealer           Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  vin              String   @unique
  year             Int
  make             String
  model            String
  trim             String?
  mileage          Int?
  bodyStyle        String?
  fuelType         String?
  transmission     String?
  exteriorColor    String?
  interiorColor    String?
  condition        String?
  price            Float?
  description      String?
  features         String[]
  photos           String[]
  cachedPhotoCount Int      @default(0)
  /** How many times photo caching has been attempted for this VIN — lets the
   * catch-up job tell "never tried" apart from "tried and genuinely has no
   * photos" instead of retrying (or silently ignoring) the same failures
   * forever. See PHOTO_CACHE_MAX_ATTEMPTS in inventory-sync.service.ts. */
  photoCacheAttempts Int    @default(0)
  photoCacheCheckedAt DateTime?
  autoDevListingId String?
  source           String   @default("catalog")
  isActive         Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@index([dealerId])
  @@index([make])
  @@index([bodyStyle])
  @@index([price])
  @@index([year])
  @@index([isActive])
  @@index([source])
}

model BlogPost {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  excerpt          String
  category         String
  author           String
  authorRole       String    @default("Staff Writer")
  authorBio        String?
  featuredImageUrl String?
  featuredImageAlt String?
  body             Json
  faqs             Json
  metaTitle        String
  metaDescription  String
  published        Boolean   @default(false)
  featured         Boolean   @default(false)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([category])
  @@index([featured])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model SyncRun {
  id        String   @id @default(cuid())
  job       String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  added     Int      @default(0)
  updated   Int      @default(0)
  removed   Int      @default(0)
  failed    Int      @default(0)
  message   String?
}

model Review {
  id                    String          @id @default(cuid())
  dealerId              String
  dealer                Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  authorName            String
  email                 String
  overallRating         Int
  customerServiceRating Int?
  qualityRating         Int?
  friendlinessRating    Int?
  pricingRating         Int?
  recommend             Boolean?
  title                 String
  comment               String
  visitDate             DateTime?
  visitType             String?
  status                String          @default("pending")
  helpfulCount          Int             @default(0)
  notHelpfulCount       Int             @default(0)
  ipAddress             String?
  /** Dealer's public reply to this review, set from the admin panel. Null means no reply yet. */
  dealerReply           String?
  dealerRepliedAt       DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  helpfulVotes          ReviewHelpful[]
  reports               ReviewReport[]

  @@index([dealerId])
  @@index([status])
  @@index([email, dealerId])
  @@unique([email, dealerId])
}

model ReviewHelpful {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  /** Anonymous browser visitor UUID — not IP (same LAN/NAT would collide). */
  visitorId String
  helpful   Boolean
  createdAt DateTime @default(now())

  @@unique([reviewId, visitorId])
  @@index([visitorId])
}

model ReviewReport {
  id         String    @id @default(cuid())
  reviewId   String
  review     Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reason     String
  ipAddress  String?
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@unique([reviewId, ipAddress])
  @@index([status])
  @@index([createdAt])
}

model RatingSourceSettings {
  id                      String   @id @default(cuid())
  googleEnabled           Boolean  @default(true)
  yelpEnabled             Boolean  @default(true)
  carfaxEnabled           Boolean  @default(true)
  autoSalesReviewsEnabled Boolean  @default(true)
  platformEnabled         Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

/**
 * Singleton admin credentials. Password is stored only here (hashed).
 * Never read admin credentials from environment variables.
 */
model AdminAccount {
  id           String   @id @default("admin")
  passwordHash String
  updatedAt    DateTime @updatedAt
}

/**
 * One row per new visitor whose location is auto-detected via IP (see
 * frontend/src/middleware.ts) — fired once per visitor, when the
 * `asr_location` cookie is first set, not a full pageview log. Powers the
 * admin "where visitors come from" dashboard tab. City/state only — never
 * store the raw IP here (see Review.ipAddress for the one place IPs are
 * already retained, for abuse handling — this table has a different,
 * narrower purpose and shouldn't grow that surface).
 */
model VisitorLocation {
  id        String   @id @default(cuid())
  city      String
  stateCode String
  path      String?
  createdAt DateTime @default(now())

  @@index([stateCode])
  @@index([createdAt])
}

/**
 * Saved / favorited vehicles.
 * Phase 1 (no auth yet): scoped by visitorId (UUID cookie / header).
 * Phase 2 (auth): set userId and merge visitor rows on login.
 * Never key favorites by IP — IPs are shared, rotate, and are PII.
 */
model SavedVehicle {
  id        String   @id @default(cuid())
  visitorId String
  userId    String?
  vehicleId String
  createdAt DateTime @default(now())

  @@unique([visitorId, vehicleId])
  @@index([visitorId])
  @@index([userId])
  @@index([vehicleId])
}
