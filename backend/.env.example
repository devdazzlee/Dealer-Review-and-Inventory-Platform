# For Neon (or any PgBouncer-fronted Postgres), keep pgbouncer=true — it tells Prisma
# it's talking through a pooler (disables incompatible prepared-statement caching).
# connection_limit=20 caps Prisma's own pool well above this app's largest concurrent
# batch (rating recalculation runs 15 parallel queries) — going lower than that causes
# queries to queue past Prisma's 10s pool timeout and fail with P2024.
DATABASE_URL="postgresql://user:password@localhost:5432/dealer_platform?pgbouncer=true&connection_limit=20"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
SITE_URL="http://localhost:3000"
