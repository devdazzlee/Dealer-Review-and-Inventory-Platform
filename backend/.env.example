# For Neon (or any PgBouncer-fronted Postgres), keep pgbouncer=true — it tells Prisma
# it's talking through a pooler (disables incompatible prepared-statement caching).
# connection_limit=20 caps Prisma's own pool well above this app's largest concurrent
# batch (rating recalculation runs 15 parallel queries) — going lower than that causes
# queries to queue past Prisma's 10s pool timeout and fail with P2024.
DATABASE_URL="postgresql://user:password@localhost:5432/dealer_platform?pgbouncer=true&connection_limit=20"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
SITE_URL="http://localhost:3000"
ADMIN_EMAIL="zoyamuhammad8295@gmail.com,bhaia9036@gmail.com"
EMAIL_FROM="AutoSalesReviews <sphirepremium@gmail.com>"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
AUTODEV_API_KEY=
AUTODEV_PHOTO_BASE_URL=https://images.auto.dev
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
CLOUDINARY_URL=
CRON_SECRET=
INTERNAL_API_KEY=ab354936a996eeb7c317e4708661da3f05dcee2e8a5846e89bf44fe84723c643

# --- Carfax rating scraper (nightly carfax-lookup job) ---
# Scrapes each dealer's public Carfax page for its aggregate star rating and
# stores it in Dealer.carfaxRating. Direct fetch only, no proxy — Carfax fronts
# these pages with bot protection, so expect a meaningful share of requests to
# come back blocked.
CARFAX_LOOKUP_ENABLED=true
# Only re-scrape a dealer whose rating was last read more than this many days ago.
CARFAX_REFRESH_DAYS=30
# Delay between dealer page requests, in ms. Lower = faster backlog drain but a
# higher chance Carfax flags the burst and starts returning 403s.
CARFAX_REQUEST_DELAY_MS=4000
# Discard a scraped rating backed by fewer than this many reviews.
CARFAX_MIN_REVIEW_COUNT=3
